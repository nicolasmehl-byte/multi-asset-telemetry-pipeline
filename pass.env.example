# Archivo de ejemplo para la configuración del proyecto

# URL completa de conexión a PostgreSQL/Supabase
# Ejemplo:
# DATABASE_URL="postgresql://postgres.XXXXXX:TU_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-password-here
DB_SSLMODE=require
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require