# Archivo de ejemplo para la configuración del proyecto
# Copia este archivo como pass.env y completa tus valores reales

# URL completa de conexión a PostgreSQL/Supabase
# Ejemplo:
# DATABASE_URL="postgresql://postgres.XXXXXX:TU_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql://postgres.TU_ID_DE_PROYECTO:TU_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"

# Variables opcionales adicionales para la conexión en la nube
# DB_HOST=aws-1-sa-east-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.XXXXXX
# DB_PASSWORD=TU_PASSWORD
# DB_SSLMODE=require